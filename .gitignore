
# ── Módulo 1: text_extraction/ ───────────────────────────────
# Saída de extração é ignorada, com uma exceção: out/ppb_rules/ é versionado
# como fixture — o único documento que acompanha o repo já paginado.
text_extraction/out/*
!text_extraction/out/ppb_rules/

# Os PDFs fonte de teste SÃO versionados (é o que torna o pipeline
# reproduzível); o resto de data/ não.
text_extraction/data/*
!text_extraction/data/pdf/
text_extraction/data/pdf/*
!text_extraction/data/pdf/*.pdf

# ── Módulo 2: semantic_seg/ ───────────────────────────────────
# Tudo em resultados/ é saída de rodada: reproduzível, muda a cada execução.
# Exceção: as rodadas sobre os documentos HRDoc (hrds-*) são versionadas, porque
# custam chamadas de API e sustentam a comparação base × _v2 × _v3. Os logs
# continuam fora (regra *.log abaixo).
semantic_seg/data/
semantic_seg/resultados/*
!semantic_seg/resultados/hrds-*
semantic_seg/out/

# ── Ambiente e credenciais ────────────────────────────────────
.env
*.env

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# ── Logs ─────────────────────────────────────────────────────
*.log

# ── Ferramentas / editores ───────────────────────────────────
# Claude Code: settings locais e worktrees (não versionar)
.claude/

# LibreOffice / Excel lock files
.~lock.*#

# ── Sistema ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

text_extraction/*.pdf
